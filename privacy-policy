<title>Privacy Policy — NIVORA</title>
<style>
  :root {
    --bg: #0f0f14;
    --surface: #17171f;
    --text: #e8e8ec;
    --text-muted: #a3a3b0;
    --accent: #7a8cff;
    --border: #26262f;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.65;
  }
  .wrap {
    max-width: 760px;
    margin: 0 auto;
    padding: 56px 24px 96px;
  }
  header {
    margin-bottom: 40px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 28px;
  }
  header h1 {
    font-size: 30px;
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  header p {
    color: var(--text-muted);
    margin: 4px 0;
    font-size: 14px;
  }
  nav {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 40px;
  }
  nav p {
    margin: 0 0 10px;
    font-weight: 600;
    color: var(--text-muted);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  nav ol {
    columns: 2;
    -webkit-columns: 2;
    margin: 0;
    padding-left: 20px;
    font-size: 14px;
  }
  nav li { margin-bottom: 6px; }
  nav a { color: var(--accent); text-decoration: none; }
  nav a:hover { text-decoration: underline; }

  section { margin-bottom: 36px; }
  h2 {
    font-size: 19px;
    margin: 0 0 12px;
    scroll-margin-top: 20px;
  }
  h3 {
    font-size: 15px;
    margin: 20px 0 8px;
    color: var(--text);
  }
  p { margin: 0 0 12px; color: var(--text); }
  ul, ol.list { margin: 0 0 12px; padding-left: 22px; }
  li { margin-bottom: 6px; }
  a { color: var(--accent); }
  strong { color: #fff; }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0 16px;
    font-size: 13.5px;
  }
  th, td {
    text-align: left;
    padding: 10px 12px;
    border: 1px solid var(--border);
    vertical-align: top;
  }
  th {
    background: var(--surface);
    font-weight: 600;
    color: var(--text-muted);
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 22px;
    margin: 12px 0;
  }
  .contact-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 22px;
    margin-top: 8px;
  }
  .contact-box a { font-weight: 600; }
  footer {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 13px;
  }
  .badge {
    display: inline-block;
    background: rgba(122,140,255,0.12);
    color: var(--accent);
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 20px;
    margin-left: 8px;
    letter-spacing: 0.02em;
  }
</style>
